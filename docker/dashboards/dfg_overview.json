{
    "dashboard": {
        "id": null,
        "title": "Distributed File Grid - Overview",
        "tags": [
            "dfg",
            "distributed-storage"
        ],
        "timezone": "browser",
        "refresh": "10s",
        "schemaVersion": 27,
        "panels": [
            {
                "id": 1,
                "title": "Healthy Cluster Servers",
                "type": "gauge",
                "gridPos": {
                    "h": 6,
                    "w": 6,
                    "x": 0,
                    "y": 0
                },
                "targets": [
                    {
                        "expr": "hc_healthy_servers",
                        "legendFormat": "Healthy Servers"
                    }
                ],
                "fieldConfig": {
                    "defaults": {
                        "thresholds": {
                            "steps": [
                                {
                                    "value": 0,
                                    "color": "red"
                                },
                                {
                                    "value": 1,
                                    "color": "yellow"
                                },
                                {
                                    "value": 3,
                                    "color": "green"
                                }
                            ]
                        },
                        "max": 5,
                        "min": 0
                    }
                }
            },
            {
                "id": 2,
                "title": "Heartbeats Received (Rate)",
                "type": "timeseries",
                "gridPos": {
                    "h": 6,
                    "w": 12,
                    "x": 6,
                    "y": 0
                },
                "targets": [
                    {
                        "expr": "rate(hc_heartbeats_received_total[1m])",
                        "legendFormat": "Heartbeats/sec"
                    }
                ]
            },
            {
                "id": 3,
                "title": "Servers Marked Unhealthy",
                "type": "stat",
                "gridPos": {
                    "h": 6,
                    "w": 6,
                    "x": 18,
                    "y": 0
                },
                "targets": [
                    {
                        "expr": "hc_servers_marked_unhealthy_total",
                        "legendFormat": "Total Unhealthy Events"
                    }
                ]
            },
            {
                "id": 4,
                "title": "File Uploads (Total)",
                "type": "stat",
                "gridPos": {
                    "h": 6,
                    "w": 6,
                    "x": 0,
                    "y": 6
                },
                "targets": [
                    {
                        "expr": "head_file_uploads_total",
                        "legendFormat": "Uploads"
                    }
                ]
            },
            {
                "id": 5,
                "title": "File Downloads (Total)",
                "type": "stat",
                "gridPos": {
                    "h": 6,
                    "w": 6,
                    "x": 6,
                    "y": 6
                },
                "targets": [
                    {
                        "expr": "head_file_downloads_total",
                        "legendFormat": "Downloads"
                    }
                ]
            },
            {
                "id": 6,
                "title": "Chunk Transfer Rate",
                "type": "timeseries",
                "gridPos": {
                    "h": 6,
                    "w": 12,
                    "x": 12,
                    "y": 6
                },
                "targets": [
                    {
                        "expr": "rate(head_chunks_transferred_total[5m])",
                        "legendFormat": "Chunks/sec"
                    }
                ]
            },
            {
                "id": 7,
                "title": "Cluster Server Messages Received",
                "type": "timeseries",
                "gridPos": {
                    "h": 6,
                    "w": 12,
                    "x": 0,
                    "y": 12
                },
                "targets": [
                    {
                        "expr": "rate(heartbeat_messages_received_total[1m])",
                        "legendFormat": "{{instance}}"
                    }
                ]
            },
            {
                "id": 8,
                "title": "Read Repairs Triggered",
                "type": "stat",
                "gridPos": {
                    "h": 6,
                    "w": 6,
                    "x": 12,
                    "y": 12
                },
                "targets": [
                    {
                        "expr": "head_read_repairs_total",
                        "legendFormat": "Read Repairs"
                    }
                ]
            },
            {
                "id": 9,
                "title": "Re-replications Triggered",
                "type": "stat",
                "gridPos": {
                    "h": 6,
                    "w": 6,
                    "x": 18,
                    "y": 12
                },
                "targets": [
                    {
                        "expr": "hc_replications_triggered_total",
                        "legendFormat": "Re-replications"
                    }
                ]
            },
            {
                "id": 10,
                "title": "System CPU Usage",
                "type": "timeseries",
                "gridPos": {
                    "h": 6,
                    "w": 8,
                    "x": 0,
                    "y": 18
                },
                "targets": [
                    {
                        "expr": "system_cpu_usage_percent",
                        "legendFormat": "{{instance}} (CPU %)"
                    }
                ]
            },
            {
                "id": 11,
                "title": "System RAM Usage",
                "type": "timeseries",
                "gridPos": {
                    "h": 6,
                    "w": 8,
                    "x": 8,
                    "y": 18
                },
                "targets": [
                    {
                        "expr": "system_ram_usage_percent",
                        "legendFormat": "{{instance}} (RAM %)"
                    }
                ]
            },
            {
                "id": 12,
                "title": "System Disk Usage",
                "type": "timeseries",
                "gridPos": {
                    "h": 6,
                    "w": 8,
                    "x": 16,
                    "y": 18
                },
                "targets": [
                    {
                        "expr": "system_disk_usage_percent",
                        "legendFormat": "{{instance}} (Disk %)"
                    }
                ]
            }
        ]
    }
}